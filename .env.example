# ─── Required ────────────────────────────────────────────────────────────────
# OpenAI key (server-side only). Used for planning (text) and artwork (images).
OPENAI_API_KEY=

# Supabase project URL and SERVICE ROLE key (server-side only — never expose
# the service role key to the browser; this app never sends it to the client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
# Storage bucket created by the migration.
SUPABASE_BUCKET=calmlings

# Override only if you route OpenAI traffic through a compatible proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# Models. The image model must support /v1/images/edits with multiple
# reference images (gpt-image-1 family).
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
# "high" asks the model to preserve reference details more faithfully.
# Leave empty if your image model does not support input_fidelity.
OPENAI_INPUT_FIDELITY=high
# Output sizes requested from the image API (WIDTHxHEIGHT).
OPENAI_IMAGE_SIZE_PORTRAIT=1024x1536
OPENAI_IMAGE_SIZE_SQUARE=1024x1024

# Cost estimate inputs (USD). Check current OpenAI pricing and adjust.
COST_PER_IMAGE_PORTRAIT=0.25
COST_PER_IMAGE_SQUARE=0.17
COST_PER_REFERENCE_IMAGE=0.01
COST_PER_PLAN=0.05

# Maximum image generations running at once (protects against rate limits).
JOB_CONCURRENCY=2

# Protect a deployed instance with HTTP basic auth (username is ignored).
APP_PASSWORD=

# Secret for the Vercel cron that drains the job queue (/api/jobs/tick).
CRON_SECRET=
